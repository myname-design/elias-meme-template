# 本地示例，无密钥。复制为 .env 后执行：
# npm run build
# node --env-file=.env dist/src/index.js
# npm start 不会自动加载 .env。
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# 自定义图片需要真实可达的 HTTPS origin；不要带 /mcp、路径或凭证。
# 仅设置变量不会创建域名、证书或 HTTPS 入口。
# PUBLIC_ORIGIN=https://memes.example.com
# Render 自动注入 PORT 和 RENDER_EXTERNAL_URL；没有 PUBLIC_ORIGIN 时使用后者。
# Render / Docker 使用 HOST=0.0.0.0、NODE_ENV=production。
# 无需 OpenAI / memecub API Key、OAuth Secret 或作者的私人配置。
